// taazo. data model
//
// MongoDB via Prisma. Children that are never queried on their own — order
// lines, batch stock, payment proofs — are embedded composite types rather
// than separate collections, which is the natural shape for this database and
// removes a join from every order read.
//
// NOTE: the local server is currently a standalone instance, which does not
// support multi-document transactions. All stock movement therefore goes
// through lib/stock.ts, which uses atomic conditional updates instead. See
// docs/BUILD-BRIEF.md §1.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- catalogue

model Category {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  slug        String  @unique
  name        String
  description String?
  /// Optional hero image for the category landing strip.
  photo       String?
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model Product {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  slug        String  @unique
  name        String
  tagline     String
  description String
  /// References Category.slug. Kept as a slug rather than a relation: the
  /// catalogue is small, and it keeps every product read to a single query.
  category    String
  size        String
  price       Int // whole rupees
  accent      String
  ingredients String[]
  nutrition   NutritionFact[]
  /// First entry is the primary image used on cards and as the hero.
  photos      String[]
  sortOrder   Int     @default(0)
  featured    Boolean @default(false)
  active      Boolean @default(true)
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, active])
}

type NutritionFact {
  label String
  value String
}

// -------------------------------------------------------------------- batch

model Batch {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String   @unique // "06-09-A"
  pressedAt DateTime
  city      String   @default("Lahore")
  note      String? // shown on the site when set
  status    String   @default("live") // draft | live | closed
  stock     BatchStock[]

  createdAt DateTime @default(now())
  closedAt  DateTime?

  @@index([status])
}

// Embedded: one row per product in a batch. `reserved` covers the window
// between reserving stock and the order being written.
type BatchStock {
  productSlug String
  bottlesMade Int
  /// Denormalised so availability can be checked inside an atomic query
  /// filter. available = bottlesMade - bottlesSold - reserved.
  available   Int @default(0)
  bottlesSold Int @default(0)
  reserved    Int @default(0)
  unsold      Int @default(0)
  wasted      Int @default(0)
}

// -------------------------------------------------------------------- reels

/// Short vertical videos — the Instagram-style content that carries this
/// brand's marketing. Uploaded in admin, shown on the storefront.
model Reel {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String?
  caption     String?
  videoUrl    String
  /// Still frame shown before the video loads, and while it is paused.
  posterUrl   String?
  /// Optional link out to the original Instagram post.
  externalUrl String?
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([active, sortOrder])
}

// ------------------------------------------------------------------- orders

model Order {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber String @unique // "TZ-2609-0042"

  status        String @default("pending") // pending|confirmed|packed|out_for_delivery|delivered|failed|cancelled
  paymentMethod String // cod | transfer
  paymentStatus String @default("pending") // pending | verified | rejected

  customerName String
  phone        String
  altPhone     String?
  addressLine  String
  area         String
  city         String  @default("Lahore")
  zoneId       String? @db.ObjectId

  deliveryDate DateTime
  deliverySlot String

  items       OrderItem[]
  subtotal    Int
  deliveryFee Int
  discount    Int         @default(0)
  total       Int
  couponCode  String?

  batchCode String?
  riderId   String? @db.ObjectId
  notes     String?
  source    String  @default("web") // web | whatsapp | phone

  paymentProof PaymentProof?

  /// Guards against a double-tapped submit creating two orders.
  ///
  /// Non-null with a generated default on purpose: MongoDB's unique index
  /// treats a missing field as null, so two orders without a key would collide.
  /// Orders created outside the web checkout (admin entry, seeds) get a
  /// generated one and are unaffected.
  idempotencyKey String @unique @default(uuid())
  /// Links the order back to the stock reserved for it, so a crash is recoverable.
  reservationId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([deliveryDate])
}

// Name and price are snapshotted: an order must always show what the customer
// actually paid, even after the product's price changes.
type OrderItem {
  productSlug   String
  nameSnapshot  String
  priceSnapshot Int
  qty           Int
  size          String
  isGiftBox     Boolean  @default(false)
  giftItems     String[] // "slug x qty" for a configured box
  noteCard      String?
  recipientName String?
}

type PaymentProof {
  url            String
  uploadedAt     DateTime
  verifiedAt     DateTime?
  verifiedBy     String?
  rejectedReason String?
}

model OrderEvent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String   @db.ObjectId
  fromStatus String?
  toStatus   String
  actorId    String?  @db.ObjectId
  note       String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

// ------------------------------------------------------------------ gifting

model CorporateLead {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  company     String
  contactName String
  phone       String
  email       String?
  headcount   Int?
  budget      String?
  occasion    String?
  eventDate   DateTime?
  message     String?
  status      String   @default("new") // new|contacted|quoted|won|lost
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}

// ----------------------------------------------------------------- delivery

model DeliveryZone {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  areas          String[]
  fee            Int
  minOrder       Int      @default(0)
  sameDayCutoff  Int      @default(13) // hour, Asia/Karachi
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
}

model Rider {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  phone  String
  active Boolean @default(true)
}

// -------------------------------------------------------------------- admin

model AdminUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("owner") // owner | staff
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId   String?  @db.ObjectId
  actorName String?
  entity    String
  entityId  String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value String // JSON-encoded
}

// ---------------------------------------------------------------- content
// Editorial content shown on the storefront's mostly-static pages. Kept as
// separate flat models rather than one generic "block" table, because each
// has a genuinely different shape and each is edited from its own admin screen.

model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  quote     String
  name      String
  city      String
  accent    String   @default("var(--color-fruit-carrot)")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active, sortOrder])
}

model FaqGroup {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  heading   String
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  items     FaqItem[]
}

type FaqItem {
  question String
  answer   String
}

model StoryChapter {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eyebrow   String
  title     String
  body      String[]
  accent    String   @default("var(--color-fruit-carrot)")
  photo     String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
}

model GiftTier {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  slug      String  @unique
  name      String
  bottles   Int
  price     Int
  blurb     String
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}
