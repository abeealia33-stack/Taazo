# ---------------------------------------------------------------- database
# Local development: MongoDB running on this machine.
# Production: a MongoDB Atlas connection string (Atlas is a replica set, so
# transactions work there with no code change).
DATABASE_URL="mongodb://localhost:27017/taazo"

# ------------------------------------------------------------------- site
# Used for canonical URLs, Open Graph tags and order-confirmation links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Chulimaar public URLs use this value instead of the old Taazo URL.
# Set to the approved HTTPS domain before deployment.
CHULIMAAR_SITE_URL="http://localhost:3000"
# Only add confirmed business channels. Blank channels are hidden.
CHULIMAAR_CONTACT_EMAIL=""
CHULIMAAR_INSTAGRAM_URL=""
CHULIMAAR_WHATSAPP=""
# Local /public paths for approved photos. Blank hero uses a labelled illustration;
# other missing photos are omitted rather than shown as empty frames.
# Logos are selected by the shared Logo component, not a generic path override.
CHULIMAAR_HERO_PHOTO=""
CHULIMAAR_HERO_PHOTO_ALT="Apricots and kernels for Chulimaar"
CHULIMAAR_OIL_PHOTO=""
CHULIMAAR_KERNELS_PHOTO=""
CHULIMAAR_PRESSING_PHOTO=""
CHULIMAAR_BOTTLE_PHOTO=""
CHULIMAAR_FOUNDER_PHOTO=""
# Optional rate limiting by IP: set ONLY to a header overwritten by your trusted
# hosting proxy (e.g. x-real-ip). Email-based rate limits always apply.
CHULIMAAR_TRUSTED_IP_HEADER=""

# ------------------------------------------------------------------- auth
# Session signing secret for the admin panel.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ------------------------------------------------------- email (optional)
# Leave empty in development: emails are printed to the server console
# instead of being sent. Get a key at resend.com to send for real.
RESEND_API_KEY=""
ORDER_NOTIFY_EMAIL=""

# ------------------------------------------------------ uploads (optional)
# Homepage photos use DATABASE_URL for durable storage when this is empty.
# Set to use Vercel Blob for homepage photos and legacy media uploads instead.
# Other legacy uploads still use public/uploads/ without this token.
BLOB_READ_WRITE_TOKEN=""
